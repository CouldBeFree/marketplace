# ─── Контракт змінних середовища ───────────────────────────────────────────
# Кожна змінна нижче описана у zod-схемі src/config/env.schema.ts.
# Реальні значення тримай у .env (він у .gitignore). Секрети тут — ФЕЙКОВІ.
# Синхронність цього файла зі схемою перевіряє `npm run check:env`.

# Режим роботи: development | test | production. Опційна, дефолт development.
NODE_ENV=development

# Порт HTTP-сервера. Опційна, дефолт 3000.
PORT=3000

# Рядок підключення до БД БЕЗ пароля (пароль — з файла-секрета).
# Порт 6432 — це PgBouncer (застосунок ходить у базу ЧЕРЕЗ пулер, не напряму в 5432).
# Обовʼязкова: без неї застосунок не стартує (fail-fast).
DB_URL=postgres://marketplace@localhost:6432/marketplace

# Шлях до файла з паролем БД. Опційна, дефолт secrets/db_password.
# Файл перечитується на кожне нове зʼєднання → ротація без рестарту.
DB_PASSWORD_FILE=secrets/db_password

# Рядок підключення до брокера подій RabbitMQ (ДЗ #19).
# Логін/пароль — ДЕВ-креденшели локального compose-брокера (rabbitmq: app/app), не секрет.
# Опційна для застосунку; ОБОВʼЯЗКОВА для демо подій (demo:publish/dlq/duplicate).
# Реальне значення тримай у .env (gitignored) / сховищі ДЗ #11; грейдер експортує своє.
BROKER_URL=amqp://app:app@localhost:5672

# Redis під КЕШ (ДЗ #23) — інстанс із maxmemory + allkeys-lru.
# Без пароля (дев-инстанс compose, не секрет). Порт поза лекційним діапазоном 22300-22399.
# Опційна для застосунку; ОБОВʼЯЗКОВА для demo:cache.
REDIS_URL=redis://localhost:6391

# Redis під ЧЕРГУ + сесії + rate-limit (ДЗ #23) — інстанс із maxmemory-policy noeviction.
# Окремий від кеша: несумісні політики витіснення (див. README «Redis…»).
# Опційна для застосунку; ОБОВʼЯЗКОВА для demo:session/ratelimit/queue.
REDIS_QUEUE_URL=redis://localhost:6392
