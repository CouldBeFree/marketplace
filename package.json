{
  "name": "marketplace-nest",
  "version": "1.0.0",
  "description": "Marketplace API — Nest (contract-first, express-openapi-validator)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/main.js",
    "start:dev": "npm run build && node --watch dist/main.js",
    "check:env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-env-example.mjs",
    "lint:spec": "redocly lint openapi/openapi.yaml",
    "bundle:spec": "redocly bundle openapi/openapi.yaml -o spec.json",
    "migrate": "bash scripts/with-secrets.sh dev npx typeorm migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev npx typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev npx typeorm migration:revert -d dist/data-source.js",
    "migrate:generate": "bash scripts/with-secrets.sh dev npx typeorm migration:generate -d dist/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo-nplus1.js",
    "report": "bash scripts/with-secrets.sh dev node dist/report.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/demo-retry.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "express": "4.22.2",
    "express-openapi-validator": "5.6.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.0"
  }
}
