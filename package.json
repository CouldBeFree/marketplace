{
  "name": "marketplace-nest",
  "version": "1.0.0",
  "description": "Marketplace API — Nest (contract-first, express-openapi-validator)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/main.js",
    "start:vault": "npm run build && bash scripts/with-secrets.sh dev node dist/main.js",
    "start:dev": "npm run build && node --watch dist/main.js",
    "check:env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-env-example.mjs",
    "lint:spec": "redocly lint openapi/openapi.yaml",
    "bundle:spec": "redocly bundle openapi/openapi.yaml -o spec.json",
    "migrate": "bash scripts/with-secrets.sh dev npx typeorm migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev npx typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev npx typeorm migration:revert -d dist/data-source.js",
    "migrate:generate": "bash scripts/with-secrets.sh dev npx typeorm migration:generate -d dist/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo-nplus1.js",
    "report": "bash scripts/with-secrets.sh dev node dist/report.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/demo-retry.js",
    "demo:publish": "bash scripts/with-secrets.sh dev node dist/demo-publish.js",
    "demo:dlq": "bash scripts/with-secrets.sh dev node dist/demo-dlq.js",
    "demo:duplicate": "bash scripts/with-secrets.sh dev node dist/demo-duplicate.js",
    "demo:outbox": "bash scripts/with-secrets.sh dev node dist/outbox/demo-outbox.js",
    "demo:crash-write": "bash scripts/with-secrets.sh dev node dist/outbox/demo-crash-write.js",
    "demo:crash-relay": "bash scripts/with-secrets.sh dev node dist/outbox/demo-crash-relay.js",
    "demo:cache": "bash scripts/with-secrets.sh dev node dist/redis/demo-cache.js",
    "demo:session": "bash scripts/with-secrets.sh dev node dist/redis/demo-session.js",
    "demo:ratelimit": "bash scripts/with-secrets.sh dev node dist/redis/demo-ratelimit.js",
    "demo:queue": "bash scripts/with-secrets.sh dev node dist/redis/demo-queue.js",
    "demo:auth": "bash scripts/with-secrets.sh dev node dist/auth/demo-auth.js",
    "demo:reuse": "bash scripts/with-secrets.sh dev node dist/auth/demo-reuse.js",
    "demo:rbac": "bash scripts/with-secrets.sh dev node dist/auth/demo-rbac.js",
    "demo:upload": "bash scripts/with-secrets.sh dev node dist/files/demo-upload.js",
    "demo:multipart": "bash scripts/with-secrets.sh dev node dist/files/demo-multipart.js",
    "demo:cdn": "bash scripts/with-secrets.sh dev node dist/files/demo-cdn.js",
    "image:build": "bash scripts/image-build.sh",
    "cluster:up": "bash scripts/cluster-up.sh",
    "cluster:down": "kind delete cluster --name ${CLUSTER:-hw28}",
    "scan": "node scripts/scan.mjs",
    "up": "bash scripts/with-secrets.sh dev bash scripts/pulumi.sh up",
    "destroy": "bash scripts/with-secrets.sh dev bash scripts/pulumi.sh destroy",
    "demo:image": "bash demo/demo-image.sh",
    "demo:rollout": "bash demo/demo-rollout.sh",
    "demo:pdb": "bash demo/demo-pdb.sh",
    "demo:logs": "bash scripts/with-secrets.sh dev node dist/observability/demo-logs.js",
    "demo:metrics": "bash scripts/with-secrets.sh dev node dist/observability/demo-metrics.js",
    "demo:trace": "bash scripts/with-secrets.sh dev node dist/observability/demo-trace.js",
    "test:integration": "jest test/integration",
    "test:e2e": "jest test/e2e",
    "test:contract": "jest test/contract/consumer",
    "verify:provider": "jest test/contract/provider"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/websockets": "^10.4.22",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/instrumentation-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "amqplib": "^0.10.4",
    "bullmq": "^6.5.0",
    "express": "4.22.2",
    "express-openapi-validator": "5.6.2",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@pact-foundation/pact": "^17.1.4",
    "@redocly/cli": "2.46.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.6.0"
  }
}
